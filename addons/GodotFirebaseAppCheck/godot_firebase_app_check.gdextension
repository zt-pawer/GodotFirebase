[configuration]
entry_symbol = "godot_firebase_app_check_start"
compatibility_minimum = 4.2

[libraries]
ios = "res://addons/GodotFirebaseAppCheck/bin/GodotFirebaseAppCheck.xcframework"
linux.arm64 = "res://addons/GodotFirebaseAppCheck/bin/godot_firebase_app_check_stub.linux.arm64.so"
linux.x86_64 = "res://addons/GodotFirebaseAppCheck/bin/godot_firebase_app_check_stub.linux.x86_64.so"
macos.arm64 = "res://addons/GodotFirebaseAppCheck/bin/GodotFirebaseAppCheck.framework"
macos.x86_64 = "res://addons/GodotFirebaseAppCheck/bin/GodotFirebaseAppCheck_x64.framework"
windows.arm64 = "res://addons/GodotFirebaseAppCheck/bin/godot_firebase_app_check_stub.windows.arm64.dll"
windows.x86_64 = "res://addons/GodotFirebaseAppCheck/bin/godot_firebase_app_check_stub.windows.x86_64.dll"

[dependencies]
ios = { "res://addons/GodotApplePluginsRuntime/bin/SwiftGodotRuntime.xcframework": "" }
macos.arm64 = { "res://addons/GodotApplePluginsRuntime/bin/SwiftGodotRuntime.framework": "" }
macos.x86_64 = { "res://addons/GodotApplePluginsRuntime/bin/SwiftGodotRuntime_x64.framework": "" }
